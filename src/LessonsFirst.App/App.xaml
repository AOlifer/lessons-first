<Application x:Class="LessonsFirst.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- Палитра бренда: Midnight / Periwinkle / Paper / Lime -->
        <SolidColorBrush x:Key="MidnightBrush" Color="#FF151B38"/>
        <SolidColorBrush x:Key="MidnightLightBrush" Color="#FF1F2749"/>
        <SolidColorBrush x:Key="PeriwinkleBrush" Color="#FF7775F5"/>
        <SolidColorBrush x:Key="PaperBrush" Color="#FFF7F6F2"/>
        <SolidColorBrush x:Key="LimeBrush" Color="#FFD7F561"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FFFF5252"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF9AA3C7"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PeriwinkleBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PaperBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="18,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
