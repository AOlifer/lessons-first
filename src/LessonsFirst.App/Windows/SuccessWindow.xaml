<Window x:Class="LessonsFirst.App.Windows.SuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сначала уроки! — успех"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="{StaticResource MidnightBrush}"
        Icon="/Assets/app-icon-256.png">

    <Grid>
        <Image Source="/Assets/lessons-first-background.png"
               Stretch="UniformToFill" Opacity="0.2"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="🎉" FontSize="96" HorizontalAlignment="Center"/>

            <TextBlock Text="Молодец! Все задачи решены"
                       FontSize="46" FontWeight="Bold"
                       Foreground="{StaticResource LimeBrush}"
                       HorizontalAlignment="Center" Margin="0,16,0,8"/>

            <TextBlock Text="Компьютер разблокирован. Хорошей учёбы!"
                       FontSize="20" Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <Border Background="#CC1F2749" CornerRadius="18" Padding="28,14"
                    HorizontalAlignment="Center">
                <TextBlock x:Name="StatsText" Text="Верных ответов: 5 · Ошибок: 0 · Время: 01:23"
                           FontSize="19" Foreground="{StaticResource PaperBrush}"
                           HorizontalAlignment="Center"/>
            </Border>

            <Button Content="Ура! К компьютеру ➜" FontSize="22" Height="58" MinWidth="240"
                    Background="{StaticResource LimeBrush}" Foreground="#FF151B38"
                    HorizontalAlignment="Center" Margin="0,32,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
