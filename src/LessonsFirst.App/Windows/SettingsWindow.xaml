<Window x:Class="LessonsFirst.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сначала уроки! — настройки"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource MidnightBrush}"
        Icon="/Assets/app-icon-256.png"
        KeyDown="Window_KeyDown">

    <StackPanel Margin="28">
        <!-- Экран подтверждения PIN -->
        <StackPanel x:Name="PinGatePanel">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Image Source="/Assets/brand-mark-dark.png" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Настройки доступны родителю" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource PaperBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Введите PIN родителя" FontSize="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,6"/>
            <PasswordBox x:Name="PinBox" Height="44" FontSize="20" Margin="0,0,0,12"
                         Background="#FF151B38" Foreground="{StaticResource PaperBrush}" BorderBrush="{StaticResource PeriwinkleBrush}"
                         BorderThickness="2" CaretBrush="{StaticResource PaperBrush}"/>
            <TextBlock x:Name="GateErrorText" Text="" Foreground="{StaticResource DangerBrush}" FontSize="14" Margin="0,0,0,8"/>
            <Button Content="Продолжить" Height="44" FontSize="17" Click="Gate_Click"/>
        </StackPanel>

        <!-- Сами настройки -->
        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
            <TextBlock Text="Настройки" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PaperBrush}" Margin="0,0,0,16"/>

            <TextBlock Text="Класс (сложность задач)" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
            <ComboBox x:Name="GradeBox" Height="40" FontSize="16" Margin="0,6,0,14"/>

            <TextBlock Text="Сколько правильных ответов для разблокировки" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
            <ComboBox x:Name="RequiredBox" Height="40" FontSize="16" Margin="0,6,0,14"/>

            <CheckBox x:Name="AutostartBox" Content="Запускаться вместе с Windows"
                      FontSize="15" Foreground="{StaticResource PaperBrush}" Margin="0,0,0,8"/>
            <CheckBox x:Name="LockOnStartupBox" Content="Блокировать при запуске Windows"
                      FontSize="15" Foreground="{StaticResource PaperBrush}" Margin="0,0,0,8"/>
            <CheckBox x:Name="LockOnResumeBox" Content="Блокировать после пробуждения и разблокировки (Win+L)"
                      FontSize="15" Foreground="{StaticResource PaperBrush}" Margin="0,0,0,18"/>

            <TextBlock Text="Обновления" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                <Button x:Name="CheckUpdateButton" Content="Проверить обновления" Height="40" FontSize="15"
                        Click="CheckUpdate_Click"/>
                <TextBlock x:Name="UpdateStatusText" Text="" FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Button Content="Сохранить" Height="46" FontSize="18" Margin="0,16,0,0"
                    Background="{StaticResource LimeBrush}" Foreground="#FF151B38" Click="Save_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="☕ Поддержать проект" Height="38" FontSize="14"
                        Background="#337775F5" Foreground="{StaticResource PaperBrush}"
                        Click="Donate_Click"/>
                <Button Content="🐛 Проблема? Напишите" Height="38" FontSize="14" Margin="10,0,0,0"
                        Background="Transparent" Foreground="{StaticResource MutedTextBrush}"
                        BorderBrush="#4D9AA3C7" BorderThickness="1"
                        Click="Issues_Click"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
