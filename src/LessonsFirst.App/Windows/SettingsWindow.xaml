<Window x:Class="LessonsFirst.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сначала уроки! — настройки"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        Background="{StaticResource MidnightBrush}"
        Icon="/Assets/app-icon-256.png"
        KeyDown="Window_KeyDown"
        ContentRendered="SettingsWindow_ContentRendered">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28">
        <!-- Экран подтверждения PIN -->
        <StackPanel x:Name="PinGatePanel">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Image Source="/Assets/brand-mark-dark.png" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Настройки доступны родителю" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource PaperBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Введите PIN родителя" FontSize="14" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,6"/>
            <PasswordBox x:Name="PinBox" Height="44" FontSize="20" Margin="0,0,0,12"
                         Background="#FF151B38" Foreground="{StaticResource PaperBrush}" BorderBrush="{StaticResource PeriwinkleBrush}"
                         BorderThickness="2" CaretBrush="{StaticResource PaperBrush}"/>
            <TextBlock x:Name="GateErrorText" Text="" Foreground="{StaticResource DangerBrush}" FontSize="14" Margin="0,0,0,8"/>
            <Button Content="Продолжить" Height="44" FontSize="17" Click="Gate_Click"/>
        </StackPanel>

        <!-- Сами настройки -->
        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">

            <TextBlock Text="Задачи" FontSize="16" FontWeight="Bold" Foreground="{StaticResource LimeBrush}" Margin="0,0,0,10"/>

            <TextBlock Text="Сложность (класс)" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
            <ComboBox x:Name="GradeBox" Height="40" FontSize="16" Margin="0,6,0,4"/>
            <TextBlock x:Name="GradeHintText" Text="" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <TextBlock Text="Предметы задач" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
            <ComboBox x:Name="SubjectBox" Height="40" FontSize="16" Margin="0,6,0,4"/>
            <TextBlock Text="Уровень и предметы фиксируются на сессию: изменения применятся к следующей."
                       FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>

            <TextBlock Text="Сколько правильных ответов нужно для доступа" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
            <ComboBox x:Name="RequiredBox" Height="40" FontSize="16" Margin="0,6,0,14"/>

            <CheckBox x:Name="ShowHintsBox" Content="Показывать подсказки к задачам"
                      FontSize="15" Foreground="{StaticResource PaperBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Подсказка объясняет способ решения, но не даёт готовый ответ"
                       FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,18"/>

            <TextBlock Text="Блокировка" FontSize="16" FontWeight="Bold" Foreground="{StaticResource LimeBrush}" Margin="0,0,0,10"/>
            <CheckBox x:Name="AutostartBox" Content="Запускаться вместе с Windows"
                      FontSize="15" Foreground="{StaticResource PaperBrush}" Margin="0,0,0,8"/>
            <CheckBox x:Name="LockOnStartupBox" Content="Блокировать при запуске Windows"
                      FontSize="15" Foreground="{StaticResource PaperBrush}" Margin="0,0,0,8"/>
            <CheckBox x:Name="LockOnResumeBox" Content="Блокировать после пробуждения и разблокировки (Win+L)"
                      FontSize="15" Foreground="{StaticResource PaperBrush}" Margin="0,0,0,18"/>

            <TextBlock Text="PIN родителя" FontSize="16" FontWeight="Bold" Foreground="{StaticResource LimeBrush}" Margin="0,0,0,10"/>
            <StackPanel x:Name="PinChangePanel" Visibility="Collapsed">
                <TextBlock Text="Текущий PIN" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                <PasswordBox x:Name="CurrentPinBox" Height="40" FontSize="18" Margin="0,4,0,10"
                             Background="#FF151B38" Foreground="{StaticResource PaperBrush}" BorderBrush="{StaticResource PeriwinkleBrush}"
                             BorderThickness="2" CaretBrush="{StaticResource PaperBrush}"/>
                <TextBlock Text="Новый PIN (минимум 4 символа)" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                <PasswordBox x:Name="NewPinBox" Height="40" FontSize="18" Margin="0,4,0,10"
                             Background="#FF151B38" Foreground="{StaticResource PaperBrush}" BorderBrush="{StaticResource PeriwinkleBrush}"
                             BorderThickness="2" CaretBrush="{StaticResource PaperBrush}"/>
                <TextBlock Text="Повторите новый PIN" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                <PasswordBox x:Name="NewPinRepeatBox" Height="40" FontSize="18" Margin="0,4,0,10"
                             Background="#FF151B38" Foreground="{StaticResource PaperBrush}" BorderBrush="{StaticResource PeriwinkleBrush}"
                             BorderThickness="2" CaretBrush="{StaticResource PaperBrush}"/>
                <TextBlock x:Name="PinChangeErrorText" Text="" FontSize="13" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <Button Content="Сохранить новый PIN" Height="42" FontSize="16" Click="SavePin_Click"/>
            </StackPanel>
            <Button x:Name="ChangePinButton" Content="Сменить PIN" Height="42" FontSize="16"
                    Background="#337775F5" Foreground="{StaticResource PaperBrush}" Click="ChangePin_Click"/>

            <TextBlock Text="Обновления" FontSize="16" FontWeight="Bold" Foreground="{StaticResource LimeBrush}" Margin="0,18,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="CheckUpdateButton" Content="Проверить обновления" Height="40" FontSize="15"
                        Click="CheckUpdate_Click"/>
                <TextBlock x:Name="UpdateStatusText" Text="" FontSize="14" Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Button Content="Сохранить" Height="46" FontSize="18" Margin="0,16,0,0"
                    Background="{StaticResource LimeBrush}" Foreground="#FF151B38" Click="Save_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="☕ Поддержать проект" Height="38" FontSize="14"
                        Background="#337775F5" Foreground="{StaticResource PaperBrush}"
                        Click="Donate_Click"/>
                <Button Content="🐛 Проблема? Напишите" Height="38" FontSize="14" Margin="10,0,0,0"
                        Background="Transparent" Foreground="{StaticResource MutedTextBrush}"
                        BorderBrush="#4D9AA3C7" BorderThickness="1"
                        Click="Issues_Click"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
