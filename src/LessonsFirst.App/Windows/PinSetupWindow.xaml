<Window x:Class="LessonsFirst.App.Windows.PinSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сначала уроки! — первый запуск"
        Width="460" SizeToContent="Height"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{StaticResource MidnightBrush}"
        Icon="/Assets/app-icon-256.png"
        KeyDown="Window_KeyDown">
    <StackPanel Margin="32">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="/Assets/brand-mark-dark.png" Height="40" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Добро пожаловать!" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource PaperBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>

        <TextBlock FontSize="15" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,4"
                   Text="Это приложение просит ребёнка решить несколько школьных задач после включения компьютера."/>
        <TextBlock FontSize="15" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,18"
                   Text="Придумайте PIN родителя — по нему вы будете обходить задачи и менять настройки."/>

        <TextBlock Text="PIN родителя (минимум 4 символа)" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
        <PasswordBox x:Name="PinBox" Height="44" FontSize="20" Margin="0,6,0,14"
                     Background="#FF151B38" Foreground="{StaticResource PaperBrush}" BorderBrush="{StaticResource PeriwinkleBrush}"
                     BorderThickness="2" CaretBrush="{StaticResource PaperBrush}"/>

        <TextBlock Text="Повторите PIN" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
        <PasswordBox x:Name="PinRepeatBox" Height="44" FontSize="20" Margin="0,6,0,14"
                     Background="#FF151B38" Foreground="{StaticResource PaperBrush}" BorderBrush="{StaticResource PeriwinkleBrush}"
                     BorderThickness="2" CaretBrush="{StaticResource PaperBrush}"/>

        <TextBlock x:Name="ErrorText" Text="" FontSize="14" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Button Content="Готово" Height="46" FontSize="19" Background="{StaticResource LimeBrush}" Foreground="#FF151B38" Click="Save_Click"/>
    </StackPanel>
</Window>
